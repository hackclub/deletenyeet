{
  "name": "deletenyeet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node --env-file-if-exists=.env hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write app scripts server.ts hmr.ts",
    "format:check": "oxfmt --check app scripts server.ts hmr.ts",
    "db": "node --env-file-if-exists=.env node_modules/remix/dist/cli-entry.js db",
    "db:up": "docker compose up -d --wait postgres",
    "tokens": "node --import remix/node-tsx scripts/generate-tokens.ts",
    "keys:generate": "node --import remix/node-tsx scripts/generate-signing-key.ts"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "pg": "^8.16.3",
    "pg-boss": "^12.37.1",
    "remix": "^3.0.0"
  },
  "devDependencies": {
    "@cloudscape-design/design-tokens": "^3.0.116",
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "latest"
  }
}
